<Window x:Class="GestorPro_Acessos.RedefinirSenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="Redefinir Palavra-passe" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Alterar Palavra-passe" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#2F3640" Margin="0,0,0,20"/>

            <TextBlock Text="Nova Palavra-passe *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNovaSenha" Height="30" FontSize="14" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Confirmar Nova Palavra-passe *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmaSenha" Height="30" FontSize="14" Padding="5" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCELAR" Height="40" Background="#7F8FA6" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="GUARDAR SENHA" Height="40" Background="#F39C12" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSalvarSenha_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
