<Window x:Class="GestorPro_Acessos.CadastroUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="GestorPro Acessos - Cadastro de Utilizador" Height="650" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="30">
        <StackPanel>

            <TextBlock x:Name="txtTituloJanela" Text="Novo Utilizador" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#2F3640" Margin="0,0,0,20"/>

            
            <TextBlock Text="Nome Completo *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNomeCompleto" Height="30" FontSize="14" Padding="5" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nome de Utilizador *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUsuario" Height="30" FontSize="14" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="E-mail *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="30" FontSize="14" Padding="5"/>
                </StackPanel>
            </Grid>

            
            <StackPanel x:Name="panelSenhas" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Palavra-passe *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtSenha" Height="30" FontSize="14" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirmar Palavra-passe *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtConfirmaSenha" Height="30" FontSize="14" Padding="5"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="A palavra-passe deve ter no mínimo 8 caracteres." FontSize="11" Foreground="#718093" Margin="0,2,0,0"/>
            </StackPanel>


            <!-- Permissões e Estado -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Perfil de Acesso *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbPerfil" Height="30" FontSize="14" SelectedIndex="0">
                        <ComboBoxItem Content="Comum"/>
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Estado *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbStatus" Height="30" FontSize="14" SelectedIndex="0">
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- NOVO: CheckBox de Bloqueio (Visível apenas na edição de contas bloqueadas) -->
            <CheckBox x:Name="chkBloqueado" Content="CONTA BLOQUEADA (Desmarque para desbloquear)" 
                      Foreground="#E84118" FontWeight="Bold" Margin="0,0,0,15" Visibility="Collapsed"/>




            <TextBlock Text="Imagem de Perfil *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbAvatar" Height="40" FontSize="14" Margin="0,0,0,30" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Tag="avatar1.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/avatar1.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 01" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar2.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/avatar2.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 02" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar3.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/avatar3.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 03" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar4.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/avatar4.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 04" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar5.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/avatar5.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 05" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnCancelar" Content="CANCELAR" Height="40" Background="#7F8FA6" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="btnGuardar" Content="GUARDAR" Height="40" Background="#44BD32" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnGuardar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
