<Window x:Class="GestorPro_Acessos.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
                Title="GestorPro Acessos - Acesso ao Sistema" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <!-- Logótipo ou Título -->
            <TextBlock Text="Bem-vindo ao GestorPro" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#2F3640"/>

            <!-- Campo: Nome de Utilizador -->
            <TextBlock Text="Nome de Utilizador" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="35" FontSize="14" Padding="5" 
                     Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <!-- Campo: Palavra-passe -->
            <TextBlock Text="Palavra-passe" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtSenha" Height="35" FontSize="14" Padding="5" 
                         Margin="0,0,0,20" VerticalContentAlignment="Center"/>

            <!-- Mensagem de Erro (Oculta por padrão) -->
            <TextBlock x:Name="txtMensagemErro" Text="Usuário ou senha inválidos." 
                       Foreground="#E84118" FontSize="13" HorizontalAlignment="Center" 
                       Margin="0,0,0,15" Visibility="Collapsed"/>

            <!-- Botão de Entrar -->
            <Button x:Name="btnEntrar" Content="ENTRAR" Height="40" FontSize="14" 
                    FontWeight="Bold" Background="#0097E6" Foreground="White" 
                    Cursor="Hand" Click="BtnEntrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
        <Button x:Name="btnSair" Content="FECHAR SISTEMA" Background="#E84118" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSair_Click" Margin="50,324,50,10">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
