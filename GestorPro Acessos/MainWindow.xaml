<Window x:Class="GestorPro_Acessos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="GestorPro Acessos - Tela Principal" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barra Lateral Esquerda (Perfil) -->
            <ColumnDefinition Width="280"/>
            <!-- Área Central (Conteúdo/Menus) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL: Informações do Utilizador Autenticado -->
        <Border Grid.Column="0" Background="#2F3640" Padding="20">
            <StackPanel>
                <TextBlock Text="Meu Perfil" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <!-- Imagem de Perfil -->
                <Ellipse Width="120" Height="120" Margin="0,0,0,15" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="imgPerfil" ImageSource="/Images/avatar1.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Dados do Utilizador -->
                <TextBlock x:Name="txtNome" Text="Nome Completo" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="txtUsuario" Text="@nomeusuario" Foreground="#A4B0BE" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <Border Background="#44BD32" CornerRadius="12" Padding="10,5" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock x:Name="txtTipoUsuario" Text="Administrador" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="Último acesso: " Foreground="#A4B0BE" FontSize="12"/>
                    <TextBlock x:Name="txtUltimoLogin" Text="21/09/2026 às 18:45" Foreground="White" FontSize="12"/>
                </StackPanel>

                <!-- Botão de Alterar Própria Senha -->
                <Button x:Name="btnAlterarMinhaSenha" Content="ALTERAR PALAVRA-PASSE" Height="35" Background="#34495E" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,10" Click="BtnAlterarMinhaSenha_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Botão de Sair -->
                <Button x:Name="btnSair" Content="TERMINAR SESSÃO" Height="40" Background="#E84118" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSair_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ÁREA CENTRAL: Menus de Navegação -->
        <Grid Grid.Column="1" Margin="40">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Painel de Controlo" FontSize="28" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,30"/>

                <WrapPanel HorizontalAlignment="Left">

                    <!-- Botão: Gestão de Utilizadores (Visível apenas para Administradores) -->
                    <Button x:Name="btnGerenciarUsuarios" Width="200" Height="150" Margin="0,0,20,20" Background="White" Cursor="Hand" Click="BtnGerenciarUsuarios_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Gerir Utilizadores" FontSize="16" FontWeight="Bold" Foreground="#353B48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Adicionar, editar e excluir" FontSize="12" Foreground="#718093" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botão: Auditoria (Visível apenas para Administradores) -->
                    <Button x:Name="btnAuditoria" Width="200" Height="150" Margin="0,0,20,20" Background="White" Cursor="Hand" Click="BtnAuditoria_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Auditoria" FontSize="16" FontWeight="Bold" Foreground="#353B48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ver histórico do sistema" FontSize="12" Foreground="#718093" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botão: Configurações do Próprio Perfil -->
                    <Button x:Name="btnMeuPerfil" Width="200" Height="150" Margin="0,0,20,20" Background="White" Cursor="Hand" Click="BtnMeuPerfil_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Minha Conta" FontSize="16" FontWeight="Bold" Foreground="#353B48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Alterar os seus dados" FontSize="12" Foreground="#718093" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>