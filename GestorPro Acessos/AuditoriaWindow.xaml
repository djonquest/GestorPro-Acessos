<Window x:Class="GestorPro_Acessos.AuditoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="GestorPro Acessos - Registos de Auditoria" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Histórico de Auditoria e Acessos" FontSize="24" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#DCDDE1" Padding="10">
            <!-- Separador: Auditoria Geral do Sistema -->
            <TabItem Header="Auditoria de Sistema" FontSize="14" FontWeight="SemiBold">
                <DataGrid x:Name="dgAuditoria" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="35" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e Hora" Binding="{Binding DataHoraTexto}" Width="150"/>
                        <DataGridTextColumn Header="Responsável" Binding="{Binding NomeResponsavel}" Width="150"/>
                        <DataGridTextColumn Header="Operação efetuada" Binding="{Binding TipoOperacao}" Width="150"/>
                        <DataGridTextColumn Header="Registo Afetado" Binding="{Binding RegistroAfetado}" Width="150"/>
                        <DataGridTextColumn Header="Detalhes/Novo Valor" Binding="{Binding NovoValor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Separador: Eventos de Autenticação -->
            <TabItem Header="Eventos de Autenticação" FontSize="14" FontWeight="SemiBold">
                <DataGrid x:Name="dgEventos" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="35" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e Hora" Binding="{Binding DataHoraTexto}" Width="150"/>
                        <DataGridTextColumn Header="Utilizador" Binding="{Binding NomeUsuarioTentativa}" Width="150"/>
                        <DataGridTextColumn Header="Evento" Binding="{Binding TipoEvento}" Width="200"/>
                        <DataGridTextColumn Header="Resultado" Binding="{Binding ResultadoOperacao}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
