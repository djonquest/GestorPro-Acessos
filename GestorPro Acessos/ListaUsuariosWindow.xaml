<Window x:Class="GestorPro_Acessos.ListaUsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="GestorPro Acessos - Lista de Utilizadores" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Cabeçalho com Filtros e Pesquisa -->
            <RowDefinition Height="Auto"/>
            <!-- Área dos Cards -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR: Filtros e Ações -->

        <!-- ÁREA DOS CARDS: Listagem através de um ListBox estilizado -->
        <WrapPanel Grid.Column="0" VerticalAlignment="Center" Height="44" Margin="0,0,88,0">
            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtPesquisa" Width="250" Height="35" Padding="5" Margin="0,0,20,0" 
                             ToolTip="Pesquise por nome, utilizador ou e-mail"/>

            <TextBlock Text="Perfil:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbFiltroPerfil" Width="150" Height="35" Margin="0,0,20,0">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Comum"/>
            </ComboBox>

            <TextBlock Text="Estado:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbFiltroStatus" Width="120" Height="35" Margin="0,0,20,0">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Ativo"/>
                <ComboBoxItem Content="Inativo"/>
            </ComboBox>

            <Button x:Name="btnFiltrar" Content="FILTRAR" Width="77" Height="35" 
                            Background="#2F3640" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnFiltrar_Click"/>
        </WrapPanel>

        <!-- Botão Adicionar (Visível apenas para Administradores) -->
        <Button x:Name="btnAdicionarUsuario" Content="+ NOVO UTILIZADOR" 
                        Background="#44BD32" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAdicionarUsuario_Click" Margin="822,4,74,10">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
        <!-- ÁREA DOS CARDS: Listagem através de um ListBox estilizado -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">

            <ListBox x:Name="lstUsuarios" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <!-- Faz com que os Cards se alinhem lado a lado -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Template do Card de Utilizador -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Background="White" Margin="10" Padding="15" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#DCDDE1" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar do Card -->
                                    <Ellipse Grid.Column="0" Width="60" Height="60" Margin="0,0,15,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ImagemCaminho}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Identificação do Utilizador -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NomeCompleto}" FontWeight="Bold" FontSize="16" Foreground="#2F3640" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NomeUsuario}" Foreground="#718093" FontSize="13" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Email}" Foreground="#0097E6" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,15,0,15" Background="#F1F2F6"/>

                                <!-- Detalhes: Perfil e Estado -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Perfil" FontSize="11" Foreground="#A4B0BE"/>
                                        <TextBlock Text="{Binding TipoUsuario}" FontWeight="SemiBold" FontSize="13" Foreground="#353B48"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Estado" FontSize="11" Foreground="#A4B0BE"/>
                                        <TextBlock Text="{Binding StatusTexto}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding CorStatus}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Último Login -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Último Acesso" FontSize="11" Foreground="#A4B0BE"/>
                                    <TextBlock Text="{Binding UltimoLoginTexto}" FontSize="12" Foreground="#353B48"/>
                                </StackPanel>

                                <!-- Botões de Ação (Editar / Senha / Excluir) -->
                                <Grid Visibility="{Binding BotoesAcaoVisiveis}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="EDITAR" Height="30" Background="#F1C40F" Foreground="White" FontWeight="Bold" Cursor="Hand" Tag="{Binding Id}" Click="BtnEditarUsuario_Click">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- NOVO BOTÃO DE SENHA -->
                                    <Button Grid.Column="2" Content="SENHA" Height="30" Background="#34495E" Foreground="White" FontWeight="Bold" Cursor="Hand" Tag="{Binding Id}" Click="BtnAlterarSenha_Click">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="4" Content="EXCLUIR" Height="30" Background="#E84118" Foreground="White" FontWeight="Bold" Cursor="Hand" Tag="{Binding Id}" Click="BtnExcluirUsuario_Click">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <Button x:Name="btnExit" Content="Sair" 
            Background="#FF1170F7" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnExit_Click" Margin="981,2,10,8" Height="32" BorderBrush="#FFCE7474"/>
    </Grid>
</Window>
