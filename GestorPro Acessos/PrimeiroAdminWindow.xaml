<Window x:Class="GestorPro_Acessos.PrimeiroAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorPro_Acessos"
        mc:Ignorable="d"
        Title="Configuração Inicial - Primeiro Administrador" Height="600" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Configuração Inicial" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#2F3640"/>
            <TextBlock Text="O sistema não possui utilizadores. Crie a conta do primeiro administrador para poder aceder." 
                       FontSize="13" Foreground="#718093" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,20"/>

            <TextBlock Text="Nome Completo" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNomeCompleto" Height="30" FontSize="14" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Nome de Utilizador" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="30" FontSize="14" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="E-mail" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="30" FontSize="14" Padding="5" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Palavra-passe" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtSenha" Height="30" FontSize="14" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Confirmar Palavra-passe" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtConfirmaSenha" Height="30" FontSize="14" Padding="5"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Imagem de Perfil *" FontWeight="SemiBold" Foreground="#353B48" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbAvatar" Height="40" FontSize="14" Margin="0,0,0,30" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Tag="avatar1.png">
                    <StackPanel Orientation="Horizontal">
                        <!-- Caminho alterado para o formato Pack URI absoluto -->
                        <Image Source="pack://application:,,,/Images/avatar1.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 01" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar2.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Images/avatar2.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 02" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar3.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Images/avatar3.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 03" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar4.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Images/avatar4.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 04" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="avatar5.png">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Images/avatar5.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Avatar 05" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

            <Button x:Name="btnCriarAdmin" Content="CRIAR ADMINISTRADOR" Height="40" FontSize="14" 
                    FontWeight="Bold" Background="#44BD32" Foreground="White" 
                    Cursor="Hand" Click="BtnCriarAdmin_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Window>